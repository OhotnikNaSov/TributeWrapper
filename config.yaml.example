# ========================================
# Tribute Webhook Server Configuration
# ========================================

# --- Основные настройки сервера ---
server:
  host: "0.0.0.0"  # Слушать на всех интерфейсах (для Docker/VPS)
  port: 8888       # Порт сервера
  debug: false     # true = полный debug лог каждого шага, false = только важные события

# --- API ключ от Tribute ---
tribute:
  api_key: "YOUR_API_KEY_HERE"  # Твой API ключ из Tribute Dashboard

# --- Конвертация валют в донат-валюту (Рины) ---
currency_rates:
  RUB: 0.01    # 100 копеек (1₽) × 0.01 = 1 Рина
  EUR: 1       # 100 центов (1€) × 1 = 100 Рин
  USD: 1       # 100 центов (1$) × 1 = 100 Рин
  UAH: 0.02    # 100 копеек (1₴) × 0.02 = 2 Рины

# --- Настройки базы данных для Tribute логов ---
# Поддерживается: mysql, sqlite, mongodb
tribute_database:
  type: "sqlite"  # mysql, sqlite, mongodb

  # SQLite настройки
  sqlite:
    path: "./data/tribute.db"

  # MySQL настройки
  mysql:
    host: "localhost"
    port: 3306
    user: "root"
    password: "your_mysql_password"
    database: "tribute"

  # MongoDB настройки
  mongodb:
    host: "localhost"
    port: 27017
    database: "tribute"
    # user: "admin"      # раскомментируй если нужна авторизация
    # password: "pass"

# --- Настройки базы данных Minecraft (для донат-валюты - Устарело) ---
# Оставлено для совместимости, но не используется
minecraft_database:
  type: "mysql"  # mysql, sqlite

  # SQLite настройки
  sqlite:
    path: "./data/minecraft.db"

  # MySQL настройки
  mysql:
    host: "localhost"
    port: 3306
    user: "minecraft"
    password: "your_minecraft_db_password"
    database: "minecraft"

  # Настройки таблицы и колонок для CoinsEngine или других Vault плагинов
  table:
    name: "coinsengine_balances"  # Название таблицы с балансами
    player_column: "player_name"   # Колонка с именем игрока (может быть player_uuid для UUID)
    currency_column: "balance"     # Колонка с балансом валюты
    currency_name: "riny"          # Название валюты

# --- Настройки Minecraft RCON (для начисления валюты) ---
# Используется для выполнения команд на сервере Minecraft
minecraft_rcon:
  host: "localhost"         # IP адрес Minecraft сервера
  port: 25575               # RCON порт (стандартный 25575)
  password: "your_rcon_password"  # RCON пароль из server.properties

  # --- Донат 1 ---
  # donation_name_1 — название доната в Tribute (поле donation_name в payload)
  # command_1 — RCON команда которая выполнится при совпадении
  donation_name_1: "Донат 1"
  command_1: "eco give %player_name% %amount%"

  # --- Донат 2 ---
  # donation_name_2 — название второго доната в Tribute
  # command_2 — RCON команда которая выполнится при совпадении
  donation_name_2: "Донат 2"
  command_2: "give %player_name% diamond %amount%"

  # Паттерны успешного выполнения команды (если хоть один найден = успех)
  # Оставь пустым [] если любой ответ считать успехом
  # Поддерживаются плейсхолдеры: {player} - имя игрока, {amount} - количество валюты
  success_patterns:
    - "Added {amount}"
    - "gave {amount}"
    - "successfully"
    - "успешно"

  # Паттерны ошибок (если хоть один найден = ошибка)
  error_patterns:
    - "player not found"
    - "not online"
    - "игрок не найден"
    - "не в сети"
    - "unknown command"
    - "неизвестная команда"

# --- Настройки Discord уведомлений ---
# Уведомления об ошибках донатов отправляются в Discord
discord:
  # Оставь пустым "" чтобы отключить уведомления
  webhook_url: ""

# --- Настройки Discord бота ---
discord_bot:
  # Токен бота (обязательно). Оставь пустым "" чтобы отключить бота
  token: ""

  # ID гильдии (сервера Discord) — бот будет работать ТОЛЬКО в этой гильдии
  guild_id: 0

  # ID канала — бот будет принимать команды ТОЛЬКО в этом канале
  channel_id: 0

  # ID ролей которым разрешено использовать команду /adduser
  # Можно указать несколько ролей. Пустой список [] = доступ только владельцу гильдии
  allowed_role_ids:
    - 12345
    - 67676767

  # RCON команда для /adduser
  # Плейсхолдеры: %nick% %rp_name% %race% %gender% %quest_link%
  adduser_command: "adduser %nick% %rp_name% %race% %gender% %quest_link%"

  # Варианты пола для команды /adduser (максимум 25)
  # name — отображается в Discord, value — передаётся в команду
  genders:
    - name: "Мужской"
      value: "male"
    - name: "Женский"
      value: "female"

  # Варианты расы для команды /adduser (максимум 25)
  # name — отображается в Discord, value — передаётся в команду
  races:
    - name: "Человек"
      value: "human"
    - name: "Эльф"
      value: "elf"
    - name: "Орк"
      value: "orc"
